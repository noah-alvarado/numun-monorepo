---
interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
}
const { title, intro, eyebrow } = Astro.props;
---

<header class="mb-10">
  {
    eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-wide text-nu-purple-400">
        {eyebrow}
      </p>
    )
  }
  <h1 class="font-display text-4xl font-bold leading-tight text-nu-purple">
    {title}
  </h1>
  {intro && <p class="mt-3 max-w-2xl text-lg text-nu-black-600">{intro}</p>}
</header>
