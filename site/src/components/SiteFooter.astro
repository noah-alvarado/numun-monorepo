---
// Site-wide footer. Sourced from /content/config/footer.md and
// /content/config/contact-links.md (both CMS-editable singletons).
import { getEntry } from "astro:content";

const footerEntry = await getEntry("footer", "footer");
const contactEntry = await getEntry("contact-links", "contact-links");
const f = footerEntry?.data;
const c = contactEntry?.data;

const platformLabel: Record<string, string> = {
  instagram: "Instagram",
  twitter: "Twitter",
  linkedin: "LinkedIn",
  facebook: "Facebook",
  youtube: "YouTube",
  other: "Link",
};
---

<footer class="mt-20 border-t border-nu-purple-100 bg-nu-purple-50">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-display text-lg font-bold text-nu-purple">NUMUN</p>
        <p class="mt-2 max-w-xs text-sm text-nu-black-600">
          Northwestern University Model United Nations.
        </p>
        {
          f?.acknowledgments && (
            <p class="mt-3 max-w-xs text-xs text-nu-black-500">
              {f.acknowledgments}
            </p>
          )
        }
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold text-nu-purple">
          Contact
        </h2>
        <ul class="mt-3 space-y-1 text-sm text-nu-black-600">
          {
            c?.primaryEmail && (
              <li>
                <a
                  class="hover:text-nu-purple"
                  href={`mailto:${c.primaryEmail}`}
                >
                  {c.primaryEmail}
                </a>
              </li>
            )
          }
          {c?.mailingAddress && <li>{c.mailingAddress}</li>}
        </ul>
        {
          c?.socialLinks && c.socialLinks.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-3 text-sm">
              {c.socialLinks.map((s) => (
                <li>
                  <a
                    class="text-nu-purple hover:underline"
                    href={s.url}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {s.label ?? platformLabel[s.platform] ?? s.platform}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold text-nu-purple">More</h2>
        <ul class="mt-3 space-y-1 text-sm text-nu-black-600">
          {
            (f?.legalLinks ?? []).map((l) => (
              <li>
                <a class="hover:text-nu-purple" href={l.href}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      f?.sponsorLogos && f.sponsorLogos.length > 0 && (
        <div class="mt-10 border-t border-nu-purple-100 pt-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-nu-black-500">
            With support from
          </p>
          <ul class="mt-3 flex flex-wrap items-center gap-6">
            {f.sponsorLogos.map((s) => {
              const logo = (
                <img
                  src={s.image.src}
                  alt={s.image.alt}
                  class="h-10 w-auto opacity-80"
                />
              );
              return (
                <li>
                  {s.href ? (
                    <a href={s.href} rel="noopener noreferrer" target="_blank">
                      {logo}
                    </a>
                  ) : (
                    logo
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )
    }

    <p class="mt-10 text-xs text-nu-black-500">
      {f?.copyrightText ?? "© Northwestern University Model United Nations"}
    </p>
  </div>
</footer>
