---
import { asAccent, accentStrip } from "../lib/accent";

interface Props {
  name: string;
  subtitle?: string;
  image?: { src: string; alt: string };
  accent?: string;
  email?: string;
  linkedIn?: string;
}
const { name, subtitle, image, accent, email, linkedIn } = Astro.props;
const a = asAccent(accent);
---

<article
  class="flex flex-col overflow-hidden rounded-lg border border-nu-purple-100 bg-white"
>
  <div class:list={["h-1.5", accentStrip[a]]}></div>
  {
    image && (
      <img
        src={image.src}
        alt={image.alt}
        class="aspect-square w-full object-cover"
        loading="lazy"
      />
    )
  }
  <div class="flex flex-1 flex-col p-4">
    <h3 class="font-display text-lg font-semibold text-nu-purple">{name}</h3>
    {subtitle && <p class="text-sm text-nu-black-500">{subtitle}</p>}
    <div class="mt-2 flex-1 text-sm text-nu-black-600"><slot /></div>
    {
      (email || linkedIn) && (
        <div class="mt-3 flex gap-3 text-sm">
          {email && (
            <a class="text-nu-purple hover:underline" href={`mailto:${email}`}>
              Email
            </a>
          )}
          {linkedIn && (
            <a
              class="text-nu-purple hover:underline"
              href={linkedIn}
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
          )}
        </div>
      )
    }
  </div>
</article>
