---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";

export async function getStaticPaths() {
  const entries = await getCollection("news");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"news">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, author, summary, heroImage, tags, seo } = entry.data;

const dateStr = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={seo?.title ?? title}
  description={seo?.description ?? summary}
  ogImage={seo?.ogImage ?? heroImage?.src}
  noindex={seo?.noindex}
  canonicalPath={`/news/${entry.id}`}
>
  <Container class="py-16">
    <a href="/news" class="text-sm font-medium text-nu-purple hover:underline">
      ← All news
    </a>

    <article class="mx-auto mt-4 max-w-3xl">
      <p class="text-sm uppercase tracking-wide text-nu-black-500">
        <time datetime={date.toISOString()}>{dateStr}</time>
        {author && ` · ${author}`}
      </p>
      <h1
        class="mt-1 font-display text-4xl font-bold leading-tight text-nu-purple"
      >
        {title}
      </h1>

      {
        heroImage && (
          <img
            src={heroImage.src}
            alt={heroImage.alt}
            class="mt-6 aspect-[16/9] w-full rounded-lg object-cover"
          />
        )
      }

      <div class="rich-text mt-8">
        <Content />
      </div>

      {
        tags && tags.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2">
            {tags.map((t) => (
              <li class="rounded-full bg-nu-purple-50 px-3 py-1 text-xs font-medium text-nu-purple">
                #{t}
              </li>
            ))}
          </ul>
        )
      }
    </article>
  </Container>
</Layout>
