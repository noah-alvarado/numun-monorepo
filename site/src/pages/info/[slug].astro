---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import PageHeader from "../../components/PageHeader.astro";

export async function getStaticPaths() {
  const entries = await getCollection("info");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"info">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, intro, sections, timeline, feeTable, documentLinks, seo } =
  entry.data;
---

<Layout
  title={seo?.title ?? title}
  description={seo?.description}
  ogImage={seo?.ogImage}
  noindex={seo?.noindex}
  canonicalPath={`/info/${entry.id}`}
>
  <Container class="py-16">
    <PageHeader title={title} intro={intro} eyebrow="Conference info" />

    <div class="rich-text max-w-3xl">
      <Content />
    </div>

    {
      sections.length > 0 && (
        <div class="mt-10 max-w-3xl space-y-8">
          {sections.map((s) => (
            <section>
              <h2 class="font-display text-xl font-semibold text-nu-purple">
                {s.heading}
              </h2>
              <p class="mt-2 whitespace-pre-line leading-relaxed text-nu-black-700">
                {s.body}
              </p>
            </section>
          ))}
        </div>
      )
    }

    {
      timeline && timeline.length > 0 && (
        <section class="mt-12 max-w-3xl">
          <h2 class="font-display text-xl font-semibold text-nu-purple">
            Timeline
          </h2>
          <ul class="mt-3 divide-y divide-nu-purple-100 rounded border border-nu-purple-100">
            {timeline.map((t) => (
              <li class="flex flex-wrap items-baseline justify-between gap-3 px-4 py-2 text-sm">
                <span class="font-medium text-nu-purple">{t.date}</span>
                <span class="text-nu-black-700">{t.label}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      feeTable && feeTable.length > 0 && (
        <section class="mt-12 max-w-3xl">
          <h2 class="font-display text-xl font-semibold text-nu-purple">
            Fees
          </h2>
          <table class="mt-3 w-full border-collapse overflow-hidden rounded border border-nu-purple-100 text-sm">
            <thead>
              <tr class="bg-nu-purple-50 text-left text-nu-purple">
                <th class="px-4 py-2 font-semibold">Item</th>
                <th class="px-4 py-2 font-semibold">Amount</th>
                <th class="px-4 py-2 font-semibold">Notes</th>
              </tr>
            </thead>
            <tbody>
              {feeTable.map((row) => (
                <tr class="border-t border-nu-purple-100">
                  <td class="px-4 py-2 text-nu-black-800">{row.item}</td>
                  <td class="px-4 py-2 text-nu-black-800">{row.amount}</td>
                  <td class="px-4 py-2 text-nu-black-500">{row.notes ?? ""}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }

    {
      documentLinks && documentLinks.length > 0 && (
        <section class="mt-12 max-w-3xl">
          <h2 class="font-display text-xl font-semibold text-nu-purple">
            Documents
          </h2>
          <ul class="mt-3 space-y-2">
            {documentLinks.map((d) => (
              <li class="rounded border border-nu-purple-100 bg-white p-3">
                <a
                  href={d.href}
                  class="font-medium text-nu-purple hover:underline"
                >
                  {d.label}
                </a>
                {d.description && (
                  <p class="mt-0.5 text-sm text-nu-black-600">
                    {d.description}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </Container>
</Layout>
