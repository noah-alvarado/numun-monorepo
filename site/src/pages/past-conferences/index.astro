---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import PageHeader from "../../components/PageHeader.astro";

const all = await getCollection("past-conferences");
const sorted = [...all].sort(
  (a, b) => b.data.editionNumber - a.data.editionNumber,
);
---

<Layout
  title="Past conferences"
  description="A look back at previous editions of NUMUN."
  canonicalPath="/past-conferences"
>
  <Container class="py-16">
    <PageHeader
      title="Past conferences"
      intro="A look back at previous editions of NUMUN."
    />

    {
      sorted.length === 0 && (
        <p class="text-nu-black-500">Conference recaps are coming soon.</p>
      )
    }

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        sorted.map((c) => (
          <a
            href={`/past-conferences/${c.id}`}
            class="group block overflow-hidden rounded-lg border border-nu-purple-100 bg-white transition hover:shadow-md"
          >
            {c.data.heroImage && (
              <img
                src={c.data.heroImage.src}
                alt={c.data.heroImage.alt}
                class="aspect-[16/9] w-full object-cover"
                loading="lazy"
              />
            )}
            <div class="p-5">
              <p class="text-xs uppercase tracking-wide text-nu-black-500">
                {c.data.dateRange}
              </p>
              <h2 class="mt-1 font-display text-xl font-semibold text-nu-purple">
                {c.data.conferenceName}
              </h2>
              <span class="mt-3 inline-block text-sm font-semibold text-nu-purple">
                Read recap →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</Layout>
