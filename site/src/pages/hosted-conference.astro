---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import { portalUrl } from "../lib/site-urls";

const hc = await getEntry("hosted-conference", "hosted-conference");
if (!hc) throw new Error("content/pages/hosted-conference.md is required");
const { Content } = await render(hc);
const {
  title,
  tagline,
  forAdvisorsBody,
  forDelegatesBody,
  registrationPortalUrl,
  seo,
} = hc.data;

if (!Astro.site) throw new Error("Astro.site is required (set SITE_BASE)");
const registerUrl = registrationPortalUrl || portalUrl(Astro.site, "/sign-up");

const infoLinks = [
  { label: "For Advisers", href: "/info/advisers" },
  { label: "For Delegates", href: "/info/delegates" },
  { label: "For Students", href: "/info/students" },
];
---

<Layout
  title={seo?.title ?? title}
  description={seo?.description ?? tagline}
  ogImage={seo?.ogImage}
  noindex={seo?.noindex}
  canonicalPath="/hosted-conference"
>
  <Container class="py-16">
    <PageHeader title={title} intro={tagline} eyebrow="The Conference" />

    <div class="flex flex-wrap gap-3">
      <a
        href={registerUrl}
        class="rounded bg-nu-purple px-5 py-2 font-semibold text-white transition hover:bg-nu-purple-700"
      >
        Register a delegation
      </a>
      <a
        href="/committees"
        class="rounded border border-nu-purple-300 px-5 py-2 font-semibold text-nu-purple transition hover:bg-nu-purple-50"
      >
        View committees
      </a>
    </div>

    <div class="rich-text mt-10 max-w-3xl">
      <Content />
    </div>

    {
      (forAdvisorsBody || forDelegatesBody) && (
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {forAdvisorsBody && (
            <section class="rounded-lg border border-nu-purple-100 bg-white p-6">
              <h2 class="font-display text-xl font-semibold text-nu-purple">
                For advisers
              </h2>
              <p class="mt-2 whitespace-pre-line text-nu-black-700">
                {forAdvisorsBody}
              </p>
              <a
                href="/info/advisers"
                class="mt-3 inline-block text-sm font-semibold text-nu-purple hover:underline"
              >
                Adviser information →
              </a>
            </section>
          )}
          {forDelegatesBody && (
            <section class="rounded-lg border border-nu-purple-100 bg-white p-6">
              <h2 class="font-display text-xl font-semibold text-nu-purple">
                For delegates
              </h2>
              <p class="mt-2 whitespace-pre-line text-nu-black-700">
                {forDelegatesBody}
              </p>
              <a
                href="/info/delegates"
                class="mt-3 inline-block text-sm font-semibold text-nu-purple hover:underline"
              >
                Delegate information →
              </a>
            </section>
          )}
        </div>
      )
    }

    <nav class="mt-12 flex flex-wrap gap-3" aria-label="Conference information">
      {
        infoLinks.map((l) => (
          <a
            href={l.href}
            class="rounded-full border border-nu-purple-200 px-4 py-1.5 text-sm font-medium text-nu-purple transition hover:bg-nu-purple-50"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </Container>
</Layout>
