---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";

const resources = await getEntry("resources", "resources");
if (!resources) throw new Error("content/pages/resources.md is required");
const { Content } = await render(resources);
const { title, intro, linkGroups, seo } = resources.data;
---

<Layout
  title={seo?.title ?? title}
  description={seo?.description}
  ogImage={seo?.ogImage}
  noindex={seo?.noindex}
  canonicalPath="/resources"
>
  <Container class="py-16">
    <PageHeader title={title} intro={intro} />

    {
      linkGroups.length > 0 && (
        <div class="grid gap-8 md:grid-cols-2">
          {linkGroups.map((group) => (
            <section>
              <h2 class="font-display text-xl font-semibold text-nu-purple">
                {group.groupTitle}
              </h2>
              <ul class="mt-3 space-y-2">
                {group.links.map((link) => (
                  <li class="rounded border border-nu-purple-100 bg-white p-3">
                    <a
                      href={link.href}
                      class="font-medium text-nu-purple hover:underline"
                    >
                      {link.label}
                    </a>
                    {link.description && (
                      <p class="mt-0.5 text-sm text-nu-black-600">
                        {link.description}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }

    <div class="rich-text mt-10 max-w-3xl">
      <Content />
    </div>
  </Container>
</Layout>
