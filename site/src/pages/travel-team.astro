---
import { getEntry, getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import PersonCard from "../components/PersonCard.astro";

const page = await getEntry("travel-team", "travel-team");
if (!page) throw new Error("content/pages/travel-team.md is required");
const { Content } = await render(page);
const { title, conferencesAttended, seo } = page.data;

const roster = await getCollection("travel-team-roster");
const withContent = await Promise.all(
  [...roster]
    .sort(
      (a, b) =>
        (a.data.order ?? 999) - (b.data.order ?? 999) ||
        a.data.name.localeCompare(b.data.name),
    )
    .map(async (e) => ({ data: e.data, Content: (await render(e)).Content })),
);

const conferences = [...conferencesAttended].sort(
  (a, b) => b.date.getTime() - a.date.getTime(),
);
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long" });
---

<Layout
  title={seo?.title ?? title}
  description={seo?.description ??
    "Northwestern's competitive Model UN travel team."}
  ogImage={seo?.ogImage}
  noindex={seo?.noindex}
  canonicalPath="/travel-team"
>
  <Container class="py-16">
    <PageHeader
      title={title}
      intro="Northwestern's competitive collegiate delegation."
    />

    <div class="rich-text max-w-3xl">
      <Content />
    </div>

    {
      withContent.length > 0 && (
        <section class="mt-12">
          <h2 class="mb-5 font-display text-2xl font-bold text-nu-purple">
            Meet the team
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {withContent.map((m) => (
              <PersonCard
                name={m.data.name}
                subtitle={m.data.teamRole}
                image={m.data.headshot}
                accent={m.data.accentColor}
              >
                {m.data.school && (
                  <p class="text-nu-black-500">
                    {m.data.school}
                    {m.data.gradYear
                      ? ` ’${String(m.data.gradYear).slice(2)}`
                      : ""}
                  </p>
                )}
                {m.data.majors.length > 0 && (
                  <p class="mt-1">
                    <span class="font-medium text-nu-black-700">Majors:</span>{" "}
                    {m.data.majors.join(", ")}
                  </p>
                )}
                {m.data.minors.length > 0 && (
                  <p>
                    <span class="font-medium text-nu-black-700">Minors:</span>{" "}
                    {m.data.minors.join(", ")}
                  </p>
                )}
                {m.data.yearsOnTeam && (
                  <p class="mt-1 text-nu-black-500">
                    {m.data.yearsOnTeam} year
                    {m.data.yearsOnTeam > 1 ? "s" : ""} on the team
                  </p>
                )}
                {m.data.quote && (
                  <details class="mt-2">
                    <summary class="cursor-pointer font-medium text-nu-purple">
                      What I’m excited for
                    </summary>
                    <p class="mt-1 italic text-nu-black-600">
                      “{m.data.quote}”
                    </p>
                  </details>
                )}
              </PersonCard>
            ))}
          </div>
        </section>
      )
    }

    {
      conferences.length > 0 && (
        <section class="mt-16">
          <h2 class="mb-5 font-display text-2xl font-bold text-nu-purple">
            Conferences we attend
          </h2>
          <div class="grid gap-6 md:grid-cols-2">
            {conferences.map((c) => (
              <article class="rounded-lg border border-nu-purple-100 bg-white p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-display text-lg font-semibold text-nu-purple">
                    {c.conferenceName}
                  </h3>
                  <span class="text-xs uppercase tracking-wide text-nu-black-500">
                    {fmtDate(c.date)}
                  </span>
                </div>
                <p class="text-sm text-nu-black-500">{c.location}</p>
                <p class="mt-2 text-sm text-nu-black-700">{c.summary}</p>
                {c.highlights && c.highlights.length > 0 && (
                  <ul class="mt-2 list-inside list-disc text-sm text-nu-black-600">
                    {c.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </section>
      )
    }
  </Container>
</Layout>
